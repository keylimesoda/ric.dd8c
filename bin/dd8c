#!/usr/bin/env python3
"""dd8c — control Dutch & Dutch 8c/6c speakers on the LAN (stdlib only).

Reverse-engineered "Ascend" mesh API (firmware 2.x):
  - mDNS:  _x-clerk._tcp (8c) / _x-clerk2._tcp (6c) -> device IPs
  - ws://<master>:8768  JSON RPC: {meta:{id,method,endpoint,targetType?,target?}, data?}
  - master election: read "master" -> target == "Master Plugin:identity".identity

Modes:
  dd8c daemon [--ip IP] [--fixture]   JSON-lines state stream on stdout,
                                       commands as JSON lines on stdin
                                       {id,cmd,args} -> {id,ok,result|error}
  dd8c status|vol DB|mute on|off|sleep on|off|input MODE|preset NAME|
       profile NAME|tone SUB BASS TREBLE|presets|profiles|discover|raw ...

Safety: this tool never sends firmware install/reset verbs. Gain writes are
clamped to the limits advertised by the room document.
"""
import argparse
import base64
import hashlib
import json
import os
import queue
import random
import select
import socket
import struct
import sys
import threading
import time
import uuid

API_PORT = 8768
UNSET = object()

# ---------------------------------------------------------------------------
# Minimal WebSocket client (RFC 6455, text frames, no extensions)
# ---------------------------------------------------------------------------


class WSError(Exception):
    pass


class WS:
    def __init__(self, host, port, timeout=6.0):
        self.sock = socket.create_connection((host, port), timeout=timeout)
        self.sock.settimeout(timeout)
        self.buf = b""
        key = base64.b64encode(os.urandom(16)).decode()
        req = (
            f"GET / HTTP/1.1\r\nHost: {host}:{port}\r\n"
            "Upgrade: websocket\r\nConnection: Upgrade\r\n"
            f"Sec-WebSocket-Key: {key}\r\nSec-WebSocket-Version: 13\r\n\r\n"
        )
        self.sock.sendall(req.encode())
        resp = b""
        while b"\r\n\r\n" not in resp:
            chunk = self.sock.recv(4096)
            if not chunk:
                raise WSError("handshake closed")
            resp += chunk
            if len(resp) > 65536:
                raise WSError("handshake too large")
        head, self.buf = resp.split(b"\r\n\r\n", 1)
        status = head.split(b"\r\n", 1)[0].decode(errors="replace")
        if " 101" not in status:
            raise WSError(f"handshake failed: {status}")
        expect = base64.b64encode(
            hashlib.sha1((key + "258EAFA5-E914-47DA-95CA-C5AB0DC85B11").encode()).digest()
        ).decode()
        if expect.lower() not in head.decode(errors="replace").lower():
            raise WSError("bad Sec-WebSocket-Accept")

    def _read(self, n):
        while len(self.buf) < n:
            chunk = self.sock.recv(65536)
            if not chunk:
                raise WSError("closed")
            self.buf += chunk
        out, self.buf = self.buf[:n], self.buf[n:]
        return out

    def _frame(self, opcode, payload):
        n = len(payload)
        head = bytes([0x80 | opcode])
        if n < 126:
            head += bytes([0x80 | n])
        elif n < 65536:
            head += bytes([0x80 | 126]) + struct.pack(">H", n)
        else:
            head += bytes([0x80 | 127]) + struct.pack(">Q", n)
        mask = os.urandom(4)
        masked = bytes(b ^ mask[i % 4] for i, b in enumerate(payload))
        self.sock.sendall(head + mask + masked)

    def send_text(self, text):
        self._frame(0x1, text.encode("utf-8"))

    def recv_text(self, timeout=None):
        """Return the next text frame; answers pings, skips control frames."""
        old = self.sock.gettimeout()
        if timeout is not None:
            self.sock.settimeout(timeout)
        try:
            msg = b""
            while True:
                b0, b1 = self._read(2)
                fin, op = b0 & 0x80, b0 & 0x0F
                masked, n = b1 & 0x80, b1 & 0x7F
                if n == 126:
                    n = struct.unpack(">H", self._read(2))[0]
                elif n == 127:
                    n = struct.unpack(">Q", self._read(8))[0]
                if n > 4_000_000:
                    raise WSError("frame too large")
                if masked:
                    mask = self._read(4)
                    data = bytes(b ^ mask[i % 4] for i, b in enumerate(self._read(n)))
                else:
                    data = self._read(n)
                if op == 0x9:  # ping -> pong
                    self._frame(0xA, data)
                    continue
                if op == 0x8:  # close
                    raise WSError("server closed")
                if op in (0x1, 0x2, 0x0):
                    msg += data
                    if fin:
                        return msg.decode("utf-8", errors="replace")
        finally:
            self.sock.settimeout(old)

    def close(self):
        try:
            self._frame(0x8, b"")
        except Exception:
            pass
        try:
            self.sock.close()
        except Exception:
            pass


# ---------------------------------------------------------------------------
# mDNS discovery (_x-clerk._tcp / _x-clerk2._tcp)
# ---------------------------------------------------------------------------


def _mdns_name(data, off):
    """Parse a DNS name (with compression). Returns (name, next_offset)."""
    labels, jumps, guard = [], 0, 0
    while guard < 64:
        guard += 1
        if off >= len(data):
            break
        ln = data[off]
        if ln == 0:
            off += 1
            break
        if ln & 0xC0 == 0xC0:
            ptr = struct.unpack(">H", data[off:off + 2])[0] & 0x3FFF
            if jumps:
                break
            jumps += 1
            rest, _ = _mdns_name(data, ptr)
            labels.append(rest)
            off += 2
            break
        labels.append(data[off + 1:off + 1 + ln].decode("utf-8", "replace"))
        off += 1 + ln
    return ".".join(x for x in labels if x), off


def discover(timeout=3.0):
    """Return [(instance, target, ip, port)] for clerk services on the LAN."""
    QUERY = b"\x00\x00\x00\x00\x00\x01\x00\x00\x00\x00\x00\x00"
    for svc in (b"\x08_x-clerk\x04_tcp\x05local\x00", b"\x09_x-clerk2\x04_tcp\x05local\x00"):
        QUERY += svc + struct.pack(">HH", 12, 1)  # PTR, IN
    sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    sock.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
    try:
        sock.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEPORT, 1)
    except OSError:
        pass
    try:
        sock.bind(("", 5353))  # mDNS answers arrive back at port 5353
    except OSError:
        pass
    try:
        sock.setsockopt(socket.IPPROTO_IP, socket.IP_MULTICAST_TTL, 2)
        sock.setsockopt(socket.IPPROTO_IP, socket.IP_MULTICAST_LOOP, 1)
    except OSError:
        pass
    sock.settimeout(0.4)
    try:
        sock.sendto(QUERY, ("224.0.0.251", 5353))
    except OSError:
        pass
    srv, a_rec, ptr = {}, {}, {}
    deadline = time.time() + timeout
    seen = set()
    while time.time() < deadline:
        try:
            data, _ = sock.recvfrom(65535)
        except socket.timeout:
            continue
        except OSError:
            break
        if len(data) < 12:
            continue
        ancount = struct.unpack(">H", data[6:8])[0]
        off = 12
        qd = struct.unpack(">H", data[4:6])[0]
        for _ in range(qd):
            _, off = _mdns_name(data, off)
            off += 4
        for _ in range(ancount):
            if off >= len(data):
                break
            name, off = _mdns_name(data, off)
            if off + 10 > len(data):
                break
            atype, _cls, _ttl, rdlen = struct.unpack(">HHIH", data[off:off + 10])
            off += 10
            rdata, rd = data[off:off + rdlen], off + rdlen
            if atype == 12:  # PTR
                pname, _ = _mdns_name(data, off)
                ptr.setdefault(name, set()).add(pname)
            elif atype == 33:  # SRV
                port = struct.unpack(">H", rdata[4:6])[0] if rdlen >= 6 else API_PORT
                target, _ = _mdns_name(data, off + 6)
                srv[name] = (target.rstrip("."), port)
            elif atype == 1 and len(rdata) == 4:
                a_rec[name.rstrip(".")] = ".".join(str(b) for b in rdata)
            off = rd
    out = []
    for svcname, instances in ptr.items():
        for inst in instances:
            ent = srv.get(inst)
            if not ent:
                continue
            target, port = ent
            ip = a_rec.get(target) or a_rec.get(target + ".local")
            if not ip:
                try:
                    ip = socket.gethostbyname(target)
                except OSError:
                    continue
            if (inst, ip) not in seen:
                seen.add((inst, ip))
                out.append((inst, target, ip, port))
    sock.close()
    if not out:  # fallback: avahi-resolvable .local names
        for n in ("8c.local",):
            try:
                ip = socket.gethostbyname(n)
            except OSError:
                continue
            if not any(e[2] == ip for e in out):
                out.append((n, n, ip, API_PORT))
    return out


# ---------------------------------------------------------------------------
# Ascend client
# ---------------------------------------------------------------------------


class Ascend:
    def __init__(self, ws):
        self.ws = ws
        self.push = []  # spontaneous messages (notify)

    def req(self, method, endpoint, target_type=None, target=None, data=UNSET, timeout=6):
        mid = str(uuid.uuid4())
        meta = {"id": mid, "method": method, "endpoint": endpoint}
        if target_type:
            meta["targetType"] = target_type
        if target:
            meta["target"] = target
        msg = {"meta": meta}
        if data is not UNSET:
            msg["data"] = data
        self.ws.send_text(json.dumps(msg))
        while True:
            j = json.loads(self.ws.recv_text(timeout=timeout))
            m = j.get("meta", {})
            if m.get("id") == mid:
                if j.get("errors"):
                    raise RuntimeError(j["errors"][0]["detail"])
                return j.get("data")
            if m.get("method") == "notify":
                self.push.append(j)

    def subscribe(self, endpoint):
        self.req("subscribe", endpoint)

    def drain_push(self):
        out, self.push = self.push, []
        return out


def connect_master(ip=None, port=API_PORT):
    """Connect to the master speaker. ip pins a host; else discover."""
    hosts = [ip] if ip else []
    if not hosts:
        try:
            hosts = [d[2] for d in discover()]
        except Exception:
            hosts = []
    random.shuffle(hosts)
    last_err = "no devices discovered"
    for h in hosts:
        try:
            ws = WS(h, port)
            a = Ascend(ws)
            ident = a.req("read", "Master Plugin:identity")
            m = a.req("read", "master")
            if m.get("target") == ident.get("identity"):
                return a, h
            ws.close()
        except Exception as e:
            last_err = str(e)
    raise RuntimeError(last_err)


def get_room(a):
    targets = a.req("read", "targets")
    room = next((t["target"] for t in targets if t.get("targetType") == "room"), None)
    if not room:
        raise RuntimeError("no room in targets")
    doc = a.req("read", "room", "room", room)
    return room, doc.get("data", doc)


# Commanded-gain authority: the daemon knows what it last wrote. Until the
# device confirms it (or 2 s pass), snapshots report the commanded value, so
# clients never see a stale echo race back and forth during scrubbing.
PENDING_GAIN = {"val": None, "ts": 0.0}
LAST_DEV_GAIN = {"val": None}
LAST_ROOM_ID = {"val": None}
LAST_GAIN_LIMITS = {"val": None}


def snapshot(a, ip):
    room, d = get_room(a)
    gain = d.get("gain") or {}
    LAST_DEV_GAIN["val"] = gain.get("global")
    LAST_ROOM_ID["val"] = room
    LAST_GAIN_LIMITS["val"] = gain.get("limits")
    pg = PENDING_GAIN
    if pg["val"] is not None:
        dev = gain.get("global")
        if isinstance(dev, (int, float)) and abs(dev - pg["val"]) < 0.06:
            pg["val"] = None  # device confirmed
        elif time.time() - pg["ts"] < 2.0:
            gain = dict(gain)
            gain["global"] = pg["val"]
        else:
            pg["val"] = None  # stale; device truth wins
    prof = {k: v.get("name") for k, v in (d.get("profiles") or {}).items()}
    tone = {}
    sel_prof = d.get("selectedProfile")
    if sel_prof in (d.get("profiles") or {}):
        s = ((d["profiles"][sel_prof].get("settings") or {}).get("room")) or {}
        tone = {k: s.get(k, 0) for k in ("sub", "bass", "treble")}
    si = d.get("streamingInfo") or {}
    return {
        "online": True,
        "ts": time.strftime("%Y-%m-%dT%H:%M:%S"),
        "masterIp": ip,
        "room": d.get("name"),
        "roomId": room,
        "version": d.get("version"),
        "selectedInput": d.get("selectedInput"),
        "selectedXLR": d.get("selectedXLR"),
        "inputModes": d.get("inputModes") or [],
        "inputLevel": d.get("inputLevel"),
        "gain": gain,
        "mute": bool((d.get("mute") or {}).get("global")),
        "sleep": bool(d.get("sleep")),
        "nightmode": bool(d.get("nightmode")),
        "frontled": bool(d.get("frontledEnable")),
        "linearPhase": bool(d.get("linearPhase")),
        "selectedProfile": sel_prof,
        "lastSelectedPreset": d.get("lastSelectedPreset"),
        "presets": {k: v.get("name") for k, v in (d.get("presets") or {}).items()},
        "profiles": prof,
        "tone": tone,
        "licenses": d.get("confirmed_licenses") or {},
        "streaming": bool(d.get("streaming")),
        "streamService": si.get("serviceName"),
        "streamDisplay": si.get("display"),
        "positions": d.get("positions") or {},
    }


# ---------------------------------------------------------------------------
# Commands (shared by daemon and one-shot CLI)
# ---------------------------------------------------------------------------

SOURCE_MODES = ("analogHighGain", "analogLowGain", "aes", "AES Streamer", "File Player")


def find_id(mapping, name):
    if not name:
        return None
    for k, v in (mapping or {}).items():
        if k == name:
            return k
        if isinstance(v, dict) and v.get("name") == name:
            return k
        if v == name:
            return k
    return None


def entry_name(entry, fallback):
    return entry.get("name", fallback) if isinstance(entry, dict) else fallback


def do_cmd(a, room_holder, cmd, args):
    """Execute one command; returns a JSON-able result. room_holder caches id."""
    def room():
        if not room_holder.get("id"):
            room_holder["id"] = get_room(a)[0]
        return room_holder["id"]

    if cmd == "status":
        return snapshot(a, room_holder.get("ip", ""))
    if cmd == "vol":
        _, d = get_room(a)
        lim = (d.get("gain") or {}).get("limits") or {"min": -70, "max": 6}
        val = max(lim.get("min", -70), min(lim.get("max", 6), float(args["db"])))
        a.req("update", "gain2", "room", room(), {"gain": round(val, 2)})
        PENDING_GAIN["val"] = val
        PENDING_GAIN["ts"] = time.time()
        return {"gain": val}
    if cmd == "mute":
        a.req("update", "mute", "room", room(),
              [{"mute": bool(args["on"]), "positionID": "global"}])
        return {"mute": bool(args["on"])}
    if cmd == "sleep":
        a.req("update", "sleep", "room", room(), {"enable": bool(args["on"])})
        return {"sleep": bool(args["on"])}
    if cmd == "frontled":
        a.req("update", "frontled", "room", room(), {"enable": bool(args["on"])})
        return {"frontled": bool(args["on"])}
    if cmd == "input":
        mode = args["mode"]
        if mode not in SOURCE_MODES:
            raise RuntimeError(f"unknown input mode: {mode}")
        if mode in ("analogHighGain", "analogLowGain", "aes"):
            a.req("update", "selectedInput", "room", room(), {"input": "XLR"})
            a.req("update", "selectedXLR", "room", room(), {"xlr": mode})
        else:
            a.req("update", "selectedInput", "room", room(), {"input": mode})
        return {"input": mode}
    if cmd == "preset":
        _, d = get_room(a)
        pid = find_id(d.get("presets"), args["name"])
        if not pid:
            raise RuntimeError("preset not found")
        a.req("select", "preset2", "room", room(), {"presetID": pid})
        return {"preset": entry_name(d["presets"][pid], pid)}
    if cmd == "profile":
        _, d = get_room(a)
        pid = find_id(d.get("profiles"), args["name"])
        if not pid:
            raise RuntimeError("profile not found")
        a.req("select", "profile", "room", room(), {"profileID": pid})
        return {"profile": entry_name(d["profiles"][pid], pid)}
    if cmd == "tone":
        _, d = get_room(a)
        cur = {}
        sp = d.get("selectedProfile")
        if sp in (d.get("profiles") or {}):
            cur = ((d["profiles"][sp].get("settings") or {}).get("room")) or {}
        def clamp(x, base):
            v = float(x if x is not None else base or 0)
            return max(-12.0, min(6.0, v))
        payload = {"sub": clamp(args.get("sub"), cur.get("sub")),
                   "bass": clamp(args.get("bass"), cur.get("bass")),
                   "treble": clamp(args.get("treble"), cur.get("treble"))}
        a.req("update", "tone-control", "room", room(), payload)
        return payload
    if cmd == "refresh":
        return {"ok": True}
    if cmd == "discover":
        return {"devices": [{"instance": i, "target": t, "ip": ip, "port": p}
                            for i, t, ip, p in discover()]}
    if cmd == "raw":
        return a.req(args["method"], args["endpoint"],
                     args.get("targetType"), args.get("target"),
                     args.get("data", UNSET))
    raise RuntimeError(f"unknown cmd: {cmd}")


# ---------------------------------------------------------------------------
# Fixture device (demo mode + tests): same contract, in-memory state
# ---------------------------------------------------------------------------

FIXTURE_DOC = {
    "name": "Living Room Zone (fixture)", "version": "2.6.43",
    "selectedInput": "XLR", "selectedXLR": "aes",
    "inputModes": list(SOURCE_MODES), "inputLevel": -42.5,
    "gain": {"global": -30.0, "activeCorrection": -10,
             "limits": {"min": -70, "max": 6, "step": 0.1}},
    "mute": {"global": False}, "sleep": False, "nightmode": False,
    "frontledEnable": True,
    "linearPhase": True, "selectedProfile": "default",
    "lastSelectedPreset": "p-flat",
    "presets": {"p-flat": {"name": "Flat"}, "p-night": {"name": "Night"},
                "p-warm": {"name": "Warm"}},
    "profiles": {"default": {"name": "Default", "settings": {"room": {
                     "sub": 0, "bass": 0, "treble": 0}}},
                 "p-rew": {"name": "REW Auto", "settings": {"room": {
                     "sub": -1.5, "bass": 0.5, "treble": 1.0}}}},
    "confirmed_licenses": {"audio": True, "streaming": False, "bacch": False},
    "streaming": False, "streamingInfo": {},
    "positions": {"pos-l": "left", "pos-r": "right"},
}


class Fixture:
    def __init__(self):
        import copy
        self.doc = copy.deepcopy(FIXTURE_DOC)

    def req(self, method, endpoint, target_type=None, target=None, data=UNSET, timeout=6):
        d = self.doc
        if method == "read" and endpoint == "targets":
            return [{"targetType": "room", "target": "fixture-room"}]
        if method == "read" and endpoint == "room":
            return {"data": d}
        if method == "update" and endpoint == "gain2":
            lim = d["gain"]["limits"]
            d["gain"]["global"] = max(lim["min"], min(lim["max"], data["gain"]))
        elif method == "update" and endpoint == "mute":
            d["mute"]["global"] = data[0]["mute"]
        elif method == "update" and endpoint == "sleep":
            d["sleep"] = data["enable"]
        elif method == "update" and endpoint == "frontled":
            d["frontledEnable"] = data["enable"]
        elif method == "update" and endpoint == "selectedInput":
            d["selectedInput"] = data["input"]
        elif method == "update" and endpoint == "selectedXLR":
            d["selectedXLR"] = data["xlr"]
        elif method == "select" and endpoint == "preset2":
            d["lastSelectedPreset"] = data["presetID"]
        elif method == "select" and endpoint == "profile":
            d["selectedProfile"] = data["profileID"]
        elif method == "update" and endpoint == "tone-control":
            s = d["profiles"][d["selectedProfile"]]["settings"]["room"]
            s.update({k: data[k] for k in ("sub", "bass", "treble")})
        return None

    def subscribe(self, endpoint):
        pass

    def drain_push(self):
        return []


def fixture_snapshot(fx=None):
    if fx is None:
        fx = Fixture()
    return snapshot_from_doc(fx.doc, "fixture")


def snapshot_from_doc(d, ip):
    gain = d.get("gain") or {}
    sp = d.get("selectedProfile")
    tone = ((d.get("profiles", {}).get(sp, {}).get("settings") or {}).get("room")) or {}
    return {
        "online": True, "ts": time.strftime("%Y-%m-%dT%H:%M:%S"), "masterIp": ip,
        "room": d.get("name"), "roomId": "fixture-room", "version": d.get("version"),
        "selectedInput": d.get("selectedInput"), "selectedXLR": d.get("selectedXLR"),
        "inputModes": d.get("inputModes"), "inputLevel": d.get("inputLevel"),
        "gain": gain, "mute": bool((d.get("mute") or {}).get("global")),
        "sleep": bool(d.get("sleep")), "nightmode": bool(d.get("nightmode")),
        "frontled": bool(d.get("frontledEnable")),
        "linearPhase": bool(d.get("linearPhase")), "selectedProfile": sp,
        "lastSelectedPreset": d.get("lastSelectedPreset"),
        "presets": {k: v.get("name") for k, v in (d.get("presets") or {}).items()},
        "profiles": {k: v.get("name") for k, v in (d.get("profiles") or {}).items()},
        "tone": {k: tone.get(k, 0) for k in ("sub", "bass", "treble")},
        "licenses": d.get("confirmed_licenses") or {},
        "streaming": bool(d.get("streaming")), "streamService": None,
        "streamDisplay": None, "positions": d.get("positions") or {},
    }


def fixture_cmd(fx, cmd, args):
    holder = {}
    return do_cmd(fx, holder, cmd, args)


# ---------------------------------------------------------------------------
# Daemon
# ---------------------------------------------------------------------------


def emit(obj):
    sys.stdout.write(json.dumps(obj, separators=(",", ":")) + "\n")
    sys.stdout.flush()


def run_daemon(ip, fixture_mode, port=API_PORT):
    if fixture_mode:
        fx = Fixture()
        emit({"event": "hello", "fixture": True})
        emit({"event": "state", "snapshot": fixture_snapshot(fx)})
        for line in sys.stdin:
            line = line.strip()
            if not line:
                continue
            try:
                req = json.loads(line)
                res = fixture_cmd(fx, req.get("cmd", ""), req.get("args") or {})
                emit({"id": req.get("id"), "ok": True, "result": res})
                emit({"event": "state", "snapshot": fixture_snapshot(fx)})
            except Exception as e:
                emit({"id": None, "ok": False, "error": str(e)})
        return

    backoff = 1.0
    cmdq = queue.Queue()

    def stdin_reader():
        for line in sys.stdin:
            line = line.strip()
            if line:
                try:
                    req = json.loads(line)
                    # Claim gain authority at ENQUEUE time, before the
                    # debounced re-read can emit a snapshot that predates
                    # this command. Setting it only inside do_cmd leaves a
                    # one-iteration window where a stale echo stomps the
                    # client's optimistic patch (the "lost step" bounce).
                    if req.get("cmd") == "vol":
                        try:
                            val = float((req.get("args") or {}).get("db"))
                            lim = LAST_GAIN_LIMITS["val"] or {}
                            if lim:
                                val = max(lim.get("min", -70),
                                          min(lim.get("max", 6), val))
                            PENDING_GAIN["val"] = val
                            PENDING_GAIN["ts"] = time.time()
                        except (TypeError, ValueError):
                            pass
                    cmdq.put(req)
                except json.JSONDecodeError:
                    cmdq.put({"id": None, "cmd": "_bad", "args": {}})
        cmdq.put(False)  # stdin closed -> exit

    threading.Thread(target=stdin_reader, daemon=True).start()

    while True:
        try:
            a, host = connect_master(ip, port)
            a.subscribe("network")
            emit({"event": "hello", "masterIp": host})
            backoff = 1.0
            holder = {"ip": host}
            emit({"event": "state", "snapshot": snapshot(a, host)})
            last_state = time.time()
            dirty = False
            gain_send = {"ts": 0.0}

            def self_process(req):
                nonlocal dirty
                if req.get("cmd") == "_bad":
                    emit({"id": req.get("id"), "ok": False, "error": "bad json"})
                    return
                if req.get("cmd") == "vol":
                    # PENDING_GAIN was claimed at enqueue time (latest wins);
                    # the serialized writer performs the actual update.
                    try:
                        val = float((req.get("args") or {}).get("db"))
                        lim = LAST_GAIN_LIMITS["val"]
                        if lim:
                            val = max(lim.get("min", -70),
                                      min(lim.get("max", 6), val))
                        emit({"id": req.get("id"), "ok": True,
                              "result": {"gain": val}})
                        dirty = True
                    except (TypeError, ValueError) as e:
                        emit({"id": req.get("id"), "ok": False,
                              "error": str(e)})
                    return
                try:
                    res = do_cmd(a, holder, req.get("cmd", ""), req.get("args") or {})
                    emit({"id": req.get("id"), "ok": True, "result": res})
                    dirty = True  # commands change state; refresh promptly
                except Exception as e:
                    emit({"id": req.get("id"), "ok": False, "error": str(e)})
            while True:
                # poll the socket for push notifications (2 Hz)
                try:
                    r, _, _ = select.select([a.ws.sock], [], [], 0.2)
                    if r:
                        j = json.loads(a.ws.recv_text(timeout=2))
                        if j.get("meta", {}).get("method") == "notify":
                            dirty = True
                except socket.timeout:
                    pass
                # Serialized gain writer: the mesh applies rapid gain2
                # writes out of order (observed: 30 ms apart arrive
                # shuffled), so we keep exactly one value in flight — the
                # latest target — and only resend until the room doc
                # confirms it. Intermediate targets are coalesced away.
                now = time.time()
                tgt = PENDING_GAIN["val"]
                if (tgt is not None and now - PENDING_GAIN["ts"] < 5.0
                        and now - gain_send["ts"] > 0.1):
                    dev = LAST_DEV_GAIN["val"]
                    if not (isinstance(dev, (int, float))
                            and abs(dev - tgt) < 0.06):
                        lim = LAST_GAIN_LIMITS["val"] or {"min": -70, "max": 6}
                        tgt = max(lim.get("min", -70),
                                  min(lim.get("max", 6), tgt))
                        try:
                            a.req("update", "gain2", "room",
                                  LAST_ROOM_ID["val"] or holder["id"],
                                  {"gain": round(tgt, 2)})
                            gain_send["ts"] = now
                        except Exception:
                            pass  # reconnection path will retry
                # debounced re-read after any room change
                if dirty and now - last_state > 0.15:
                    dirty = False
                    last_state = now
                    emit({"event": "state", "snapshot": snapshot(a, host)})
                # commands: drain the queue (up to 30 per iteration) so a
                # burst of steps is processed in one pass, not one per loop.
                drained = False
                for _ in range(30):
                    try:
                        req = cmdq.get_nowait()
                    except queue.Empty:
                        break
                    drained = True
                    if req is False:
                        return  # stdin closed
                    self_process(req)
                if not drained:
                    continue
                self_process(req)
        except Exception as e:
            emit({"event": "offline", "error": str(e)})
            try:
                a.ws.close()
            except Exception:
                pass
            # drain pending commands with errors while offline
            time.sleep(backoff)
            backoff = min(30.0, backoff * 2)


# ---------------------------------------------------------------------------
# One-shot CLI
# ---------------------------------------------------------------------------


def main():
    ap = argparse.ArgumentParser(prog="dd8c", description=__doc__.splitlines()[0])
    ap.add_argument("--ip", default="", help="pin master IP (skip discovery)")
    ap.add_argument("--port", type=int, default=API_PORT, help="client API port (default 8768)")
    sub = ap.add_subparsers(dest="cmd", required=True)

    p = sub.add_parser("daemon")
    p.add_argument("--fixture", action="store_true", help="in-memory demo state")
    sub.add_parser("status")
    sub.add_parser("discover")
    p = sub.add_parser("vol"); p.add_argument("db", type=float)
    p = sub.add_parser("mute"); p.add_argument("state", choices=["on", "off"])
    p = sub.add_parser("sleep"); p.add_argument("state", choices=["on", "off"])
    p = sub.add_parser("frontled"); p.add_argument("state", choices=["on", "off"])
    p = sub.add_parser("input"); p.add_argument("mode", choices=list(SOURCE_MODES))
    p = sub.add_parser("preset"); p.add_argument("name")
    p = sub.add_parser("profile"); p.add_argument("name")
    p = sub.add_parser("tone")
    p.add_argument("--sub", type=float); p.add_argument("--bass", type=float)
    p.add_argument("--treble", type=float)
    p = sub.add_parser("raw")
    p.add_argument("method"); p.add_argument("endpoint")
    p.add_argument("--type", dest="targetType"); p.add_argument("--target")
    p.add_argument("--data")

    args = ap.parse_args()

    if args.cmd == "daemon":
        run_daemon(args.ip or None, fixture_mode=args.fixture, port=args.port)
        return

    if args.cmd == "discover":
        print(json.dumps([{"instance": i, "target": t, "ip": ip, "port": pt}
                          for i, t, ip, pt in discover()], indent=1))
        return

    a, host = connect_master(args.ip or None, args.port)
    holder = {"ip": host}
    try:
        if args.cmd == "status":
            print(json.dumps(snapshot(a, host), indent=1))
        elif args.cmd == "vol":
            print(json.dumps(do_cmd(a, holder, "vol", {"db": args.db})))
        elif args.cmd in ("mute", "sleep", "frontled"):
            print(json.dumps(do_cmd(a, holder, args.cmd, {"on": args.state == "on"})))
        elif args.cmd == "input":
            print(json.dumps(do_cmd(a, holder, "input", {"mode": args.mode})))
        elif args.cmd in ("preset", "profile"):
            print(json.dumps(do_cmd(a, holder, args.cmd, {"name": args.name})))
        elif args.cmd == "tone":
            print(json.dumps(do_cmd(a, holder, "tone",
                                    {"sub": args.sub, "bass": args.bass,
                                     "treble": args.treble})))
        elif args.cmd == "raw":
            data = json.loads(args.data) if args.data else UNSET
            print(json.dumps(a.req(args.method, args.endpoint, args.targetType,
                                   args.target, data), indent=1))
    finally:
        a.ws.close()


if __name__ == "__main__":
    main()
